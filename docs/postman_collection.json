{
	"info": {
		"name": "Invoice & Payment Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Register Business",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"My Business\"}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "{{base_url}}/v1/businesses" }
			}
		},
		{
			"name": "Create Customer",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{api_key}}", "type": "text" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\"name\": \"John Doe\", \"email\": \"john@example.com\"}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "{{base_url}}/v1/customers" }
			}
		},
		{
			"name": "List Customers",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{api_key}}", "type": "text" }
				],
				"url": { "raw": "{{base_url}}/v1/customers" }
			}
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000" },
		{ "key": "api_key", "value": "your_api_key_here" }
	]
}
